# Alembic configuration - generated by Gefjon.
#
# NOTE: this file is read by Alembic with the platform's default encoding,
# so keep it ASCII-only.
#
# script_location uses %(here)s, so the file can live anywhere and still
# resolve correctly; nothing here depends on the current working directory.

[alembic]
script_location = %(here)s
# Prepend the project root so the generated model package is importable.
prepend_sys_path = ..
file_template = %%(rev)s_%%(slug)s

# Database URL. Leave empty to let DATABASE_DSN or data/install.lock decide.
# Percent signs must be doubled (configparser interpolation).
sqlalchemy.url = __DATABASE_URL__

# Include other schemas in autogenerate comparison (off by default).
include_schemas = false

[gefjon]
# Model package produced by `gefjon generate`; env.py imports Base from it.
models_package = __MODELS_PACKAGE__

[loggers]
keys = root,sqlalchemy,alembic

[handlers]
keys = console

[formatters]
keys = generic

[logger_root]
level = WARNING
handlers = console
qualname =

[logger_sqlalchemy]
level = WARNING
handlers =
qualname = sqlalchemy.engine

[logger_alembic]
level = INFO
handlers =
qualname = alembic

[handler_console]
class = StreamHandler
args = (sys.stderr,)
level = NOTSET
formatter = generic

[formatter_generic]
# NOTE: Python's logging.config reads format/datefmt with raw=True, so these
# use single % (unlike the alembic options above, which need %%). 
format = %(levelname)-5.5s [%(name)s] %(message)s
datefmt = %H:%M:%S
